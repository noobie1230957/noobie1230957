  options = ['Tiny','Small','Normal','Large'])
color  tbl_bg_col   = input.color(color.new(color.black, 55), '🎨 Background',  group = '── Dashboard ──')
color  tbl_brd_col  = input.color(color.new(color.gray,  40), '🎨 Border',      group = '── Dashboard ──')
color  tbl_lbl_col  = input.color(color.new(color.gray,  10), '🎨 Label Text',  group = '── Dashboard ──')
color  tbl_val_col  = input.color(color.white,               '🎨 Value Text',  group = '── Dashboard ──')
color  tbl_good_col = input.color(color.lime,                '🎨 Good Signal', group = '── Dashboard ──')
color  tbl_warn_col = input.color(color.yellow,              '🎨 Moderate',    group = '── Dashboard ──')
color  tbl_bad_col  = input.color(color.red,                 '🎨 Weak Signal', group = '── Dashboard ──')

// ════════════════════════════════════════════════════════════════════════════
// 📌 HELPERS
// ════════════════════════════════════════════════════════════════════════════

tbl_position() =>
    tbl_pos_inp == 'Top Left'       ? position.top_left      :
     tbl_pos_inp == 'Top Center'    ? position.top_center    :
     tbl_pos_inp == 'Top Right'     ? position.top_right     :
     tbl_pos_inp == 'Middle Left'   ? position.middle_left   :
     tbl_pos_inp == 'Middle Center' ? position.middle_center :
     tbl_pos_inp == 'Middle Right'  ? position.middle_right  :
     tbl_pos_inp == 'Bottom Left'   ? position.bottom_left   :
     tbl_pos_inp == 'Bottom Center' ? position.bottom_center :
     position.bottom_right

tbl_sz() =>
    tbl_size_inp == 'Tiny'   ? size.tiny   :
     tbl_size_inp == 'Normal' ? size.normal :
     tbl_size_inp == 'Large'  ? size.large  :
     size.small

clamp(x, lo, hi) => math.max(lo, math.min(x, hi))
scale01(x, len) =>
    lo = ta.lowest(x, len)
    hi = ta.highest(x, len)
    hi == lo ? 0.5 : clamp((x - lo) / (hi - lo), 0.0, 1.0)
compress(d) => math.log(1.0 + math.abs(d))
normScore(x) => 1.0 / (1.0 + math.exp(-clamp(x, -8, 8)))
srcName(id) => id == 0 ? "Open" : id == 1 ? "High" : id == 2 ? "Low" : "Close"

// ── SMART ZONE LABEL HELPERS (NEW — display only, no trading logic) ──
makeBar(float p) =>
    int f = int(math.round(clamp(p, 0.0, 100.0) / 10.0))
    string s = ""
    for i = 1 to 10
        s := s + (i <= f ? "█" : "░")
    s
smartCol(float bull) => bull >= 75 ? color.lime : bull >= 45 ? color.yellow : bull >= 20 ? color.orange : color.red
pctTxt(float v) => str.tostring(math.round(clamp(v, 0.0, 100.0))) + "%"
ynTxt(bool b) => b ? "YES" : "NO"
momTxt(bool rising, float drive) => rising and drive >= 0.55 ? "STRONG ↑" : rising ? "RISING ↑" : drive < 0.40 ? "WEAK ↓" : "WEAKENING ↓"

ma(src, len, typ) =>
    switch typ
        "SMA" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "WMA" => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        "RMA" => ta.rma(src, len)
        "HMA" => ta.hma(src, len)
        "TEMA" =>
            ema1 = ta.ema(src, len)
            ema2 = ta.ema(ema1, len)
            ema3 = ta.ema(ema2, len)
            3.0 * (ema1 - ema2) + ema3
        "ZLEMA" =>
            lag = math.max(1, math.floor((len - 1) / 2))
            ta.ema(src + (src - src[lag]), len)
        "KAMA" =>
            changeAbs = math.abs(src - src[len])
            volatility = math.sum(math.abs(src - src[1]), len)
            er = volatility == 0 ? 0.0 : changeAbs / volatility
            fastSC = 2.0 / 3.0
            slowSC = 2.0 / 31.0
            sc = math.pow(er * (fastSC - slowSC) + slowSC, 2)
            var float kama = na
            kama := na(kama[1]) ? src : kama[1] + sc * (src - kama[1])
        "ALMA" => ta.alma(src, len, 0.85, 6.0)
        => ta.ema(src, len)

// ════════════════════════════════════════════════════════════════════════════
// 📌 AI ENGINE — FEATURES
// ════════════════════════════════════════════════════════════════════════════

featTrend(src, atrVal) =>
    fast = ta.ema(src, 10)
    slow = ta.ema(src, 34)
    atrVal == 0 ? 0.0 : clamp((fast - slow) / atrVal, -3, 3) / 3
featMean(src) =>
    basis = ta.sma(src, 30)
    dev = ta.stdev(src, 30)
    z = dev == 0 ? 0.0 : (src - basis) / dev
    clamp(-z, -3, 3) / 3
featMomentum(src) =>
    roc = src / src[14] - 1.0
    clamp(roc / 0.05, -3, 3) / 3
featVol(src) => scale01(ta.stdev(src, 20), 100) * 2.0 - 1.0
featRange(src) =>
    rng = high - low
    rng == 0 ? 0.0 : clamp(((src - low) / rng) * 2.0 - 1.0, -1, 1)
featSlope(src, atrVal) =>
    atrVal == 0 ? 0.0 : clamp((src - src[3]) / atrVal, -3, 3) / 3

atrNow = ta.atr(14)

oT=featTrend(open,atrNow), oM=featMean(open), oMo=featMomentum(open), oV=featVol(open), oR=featRange(open), oS=featSlope(open,atrNow)
hT=featTrend(high,atrNow), hM=featMean(high), hMo=featMomentum(high), hV=featVol(high), hR=featRange(high), hS=featSlope(high,atrNow)
lT=featTrend(low,atrNow),  lM=featMean(low),  lMo=featMomentum(low),  lV=featVol(low),  lR=featRange(low),  lS=featSlope(low,atrNow)
cT=featTrend(close,atrNow),cM=featMean(close),cMo=featMomentum(close),cV=featVol(close),cR=featRange(close),cS=featSlope(close,atrNow)

valid(t, m, mo, v, r, s) => not na(t) and not na(m) and not na(mo) and not na(v) and not na(r) and not na(s)
makeRow(t, m, mo, v, r, s, outcome) => array.from(t, m, mo, v, r, s, float(outcome))

var matrix<float> bankO = matrix.new<float>(0, 7)
var matrix<float> bankH = matrix.new<float>(0, 7)
var matrix<float> bankL = matrix.new<float>(0, 7)
var matrix<float> bankC = matrix.new<float>(0, 7)
var matrix<float> bankAll = matrix.new<float>(0, 7)

addBank(matrix<float> m, array<float> row, int limit) =>
    m.add_row(0, row)
    if m.rows() > limit
        m.remove_row(m.rows() - 1)

moveFwd = close - close[horizonBars]
bandFwd = learnAtrFactor * atrNow[horizonBars]
outcome = moveFwd > 2 * bandFwd ? 3 : moveFwd > bandFwd ? 2 : moveFwd > 0 ? 1 : moveFwd < -2 * bandFwd ? -3 : moveFwd < -bandFwd ? -2 : moveFwd < 0 ? -1 : 0

rowO = makeRow(oT[horizonBars], oM[horizonBars], oMo[horizonBars], oV[horizonBars], oR[horizonBars], oS[horizonBars], outcome)
rowH = makeRow(hT[horizonBars], hM[horizonBars], hMo[horizonBars], hV[horizonBars], hR[horizonBars], hS[horizonBars], outcome)
rowL = makeRow(lT[horizonBars], lM[horizonBars], lMo[horizonBars], lV[horizonBars], lR[horizonBars], lS[horizonBars], outcome)
rowC = makeRow(cT[horizonBars], cM[horizonBars], cMo[horizonBars], cV[horizonBars], cR[horizonBars], cS[horizonBars], outcome)

validO = valid(oT[horizonBars], oM[horizonBars], oMo[horizonBars], oV[horizonBars], oR[horizonBars], oS[horizonBars])
validH = valid(hT[horizonBars], hM[horizonBars], hMo[horizonBars], hV[horizonBars], hR[horizonBars], hS[horizonBars])
validL = valid(lT[horizonBars], lM[horizonBars], lMo[horizonBars], lV[horizonBars], lR[horizonBars], lS[horizonBars])
validC = valid(cT[horizonBars], cM[horizonBars], cMo[horizonBars], cV[horizonBars], cR[horizonBars], cS[horizonBars])

if barstate.isconfirmed and bar_index > horizonBars + 120
    if validO
        addBank(bankO, rowO, memoryDepth)
        addBank(bankAll, rowO, memoryDepth * 4)
    if validH
        addBank(bankH, rowH, memoryDepth)
        addBank(bankAll, rowH, memoryDepth * 4)
    if validL
        addBank(bankL, rowL, memoryDepth)
        addBank(bankAll, rowL, memoryDepth * 4)
    if validC
        addBank(bankC, rowC, memoryDepth)
        addBank(bankAll, rowC, memoryDepth * 4)

autoFeatureWeights(matrix<float> m, int minN, float floor) =>
    int n = m.rows()
    array<float> imp = array.new<float>(6, 1.0)
    if n >= minN
        array<float> sumB = array.new<float>(6, 0.0)
        array<float> sumS = array.new<float>(6, 0.0)
        array<float> sqB = array.new<float>(6, 0.0)
        array<float> sqS = array.new<float>(6, 0.0)
        int cntB = 0
        int cntS = 0
        for i = 0 to n - 1
            cls = m.get(i, 6)
            if cls != 0
                isBull = cls > 0
                for j = 0 to 5
                    val = m.get(i, j)
                    if isBull
                        sumB.set(j, sumB.get(j) + val)
                        sqB.set(j, sqB.get(j) + val * val)
                    else
                        sumS.set(j, sumS.get(j) + val)
                        sqS.set(j, sqS.get(j) + val * val)
                cntB += isBull ? 1 : 0
                cntS += isBull ? 0 : 1
        if cntB > 3 and cntS > 3
            maxF = 0.0
            fish = array.new<float>(6, 0.0)
            for j = 0 to 5
                meanB = sumB.get(j) / cntB
                meanS = sumS.get(j) / cntS
                varB = math.max(0.0, sqB.get(j) / cntB - meanB * meanB)
                varS = math.max(0.0, sqS.get(j) / cntS - meanS * meanS)
                f = math.pow(meanB - meanS, 2) / (varB + varS + 0.000001)
                fish.set(j, f)
                maxF := math.max(maxF, f)
            for j = 0 to 5
                norm = maxF > 0 ? fish.get(j) / maxF : 1.0
                imp.set(j, math.max(floor, norm * 8.0))
    imp

var array<float> wAuto = array.new<float>(6, 1.0)
if useFisher and barstate.isconfirmed
    wRaw = autoFeatureWeights(bankAll, minRows, fisherFloor)
    for j = 0 to 5
        prev = wAuto.get(j)
        wAuto.set(j, prev + fisherSpeed * (wRaw.get(j) - prev))

wT  = useFisher ? wAuto.get(0) : 1.0
wM  = useFisher ? wAuto.get(1) : 1.0
wMo = useFisher ? wAuto.get(2) : 1.0
wV  = useFisher ? wAuto.get(3) : 1.0
wR  = useFisher ? wAuto.get(4) : 1.0
wS  = useFisher ? wAuto.get(5) : 1.0

gapTo(t, m, mo, v, r, s, array<float> row) =>
    wT * compress(t - row.get(0)) + wM * compress(m - row.get(1)) + wMo * compress(mo - row.get(2)) +
     wV * compress(v - row.get(3)) + wR * compress(r - row.get(4)) + wS * compress(s - row.get(5))

knnScore(t, m, mo, v, r, s, matrix<float> bank) =>
    gaps = array.new<float>()
    classes = array.new<float>()
    n = bank.rows()
    scanEnd = math.min(n - 1, memoryDepth - 1)
    if n > 1 and valid(t, m, mo, v, r, s)
        for i = 0 to scanEnd
            if i % spacingBars == 0
                row = bank.row(i)
                g = gapTo(t, m, mo, v, r, s, row)
                cls = row.get(6)
                if not na(g) and cls != 0
                    if gaps.size() < kNeighbors
                        gaps.push(g)
                        classes.push(cls)
                    else
                        worst = 0
                        worstGap = gaps.get(0)
                        for j = 1 to gaps.size() - 1
                            gj = gaps.get(j)
                            if gj > worstGap
                                worstGap := gj
                                worst := j
                        if g < worstGap
                            gaps.set(worst, g)
                            classes.set(worst, cls)
    total=0.0, bull=0.0, bear=0.0, score=0.0, gapSum=0.0
    k = gaps.size()
    if k > 0
        for j = 0 to k - 1
            g = gaps.get(j)
            cls = classes.get(j)
            wg = 1.0 / (1.0 + g)
            total += wg
            score += cls * wg
            bull += cls > 0 ? wg : 0.0
            bear += cls < 0 ? wg : 0.0
            gapSum += g
    analog = total > 0 ? score / total : 0.0
    dir    = analog > 0.15 ? 1 : analog < -0.15 ? -1 : 0
    agree  = total > 0 ? (dir == 1 ? bull : dir == -1 ? bear : 0.0) / total : 0.0
    avgGap = k > 0 ? gapSum / k : 0.0
    gapScale = (wT + wM + wMo + wV + wR + wS) * 0.45 + 0.000001
    tight    = clamp(1.0 - avgGap / gapScale, 0.0, 1.0)
    [analog, agree, tight, k]

[oAnalog, oAgree, oTight, oK] = knnScore(oT, oM, oMo, oV, oR, oS, bankO)
[hAnalog, hAgree, hTight, hK] = knnScore(hT, hM, hMo, hV, hR, hS, bankH)
[lAnalog, lAgree, lTight, lK] = knnScore(lT, lM, lMo, lV, lR, lS, bankL)
[cAnalog, cAgree, cTight, cK] = knnScore(cT, cM, cMo, cV, cR, cS, bankC)

beta1 = 0.9, beta2 = 0.999, eps = 0.00000001
adam(weight, grad, mom, vel, step) =>
    newMom = beta1 * mom + (1.0 - beta1) * grad
    newVel = beta2 * vel + (1.0 - beta2) * grad * grad
    mHat = newMom / (1.0 - math.pow(beta1, step))
    vHat = newVel / (1.0 - math.pow(beta2, step))
    newWeight = weight - learnRate * mHat / (math.sqrt(vHat) + eps)
    [newWeight, newMom, newVel]

var float nt=0.01, var float nm=0.01, var float nmo=0.01, var float nv=0.01, var float nr=0.01, var float ns=0.01, var float nb=0.0
var float mt=0.0, var float mm=0.0, var float mmo=0.0, var float mv=0.0, var float mr=0.0, var float ms=0.0, var float mb=0.0
var float vt=0.0, var float vm=0.0, var float vmo=0.0, var float vv=0.0, var float vr=0.0, var float vs=0.0, var float vb=0.0
var int step = 0

targetDir = outcome > 0 ? 1.0 : outcome < 0 ? -1.0 : 0.0
trainPred = nt*cT[horizonBars] + nm*cM[horizonBars] + nmo*cMo[horizonBars] + nv*cV[horizonBars] + nr*cR[horizonBars] + ns*cS[horizonBars] + nb
trainErr  = trainPred - targetDir
trainAbsErr = math.abs(trainErr)
trainGrad   = trainAbsErr <= huberD ? trainErr : huberD * math.sign(trainErr)

if useNeural and barstate.isconfirmed and bar_index > horizonBars + 120 and validC and targetDir != 0
    step += 1
    [nt2, mt2, vt2] = adam(nt, trainGrad * cT[horizonBars], mt, vt, step)
    [nm2, mm2, vm2] = adam(nm, trainGrad * cM[horizonBars], mm, vm, step)
    [nmo2, mmo2, vmo2] = adam(nmo, trainGrad * cMo[horizonBars], mmo, vmo, step)
    [nv2, mv2, vv2] = adam(nv, trainGrad * cV[horizonBars], mv, vv, step)
    [nr2, mr2, vr2] = adam(nr, trainGrad * cR[horizonBars], mr, vr, step)
    [ns2, ms2, vs2] = adam(ns, trainGrad * cS[horizonBars], ms, vs, step)
    [nb2, mb2, vb2] = adam(nb, trainGrad, mb, vb, step)
    nt := nt2, nm := nm2, nmo := nmo2, nv := nv2, nr := nr2, ns := ns2, nb := nb2
    mt := mt2, mm := mm2, mmo := mmo2, mv := mv2, mr := mr2, ms := ms2, mb := mb2
    vt := vt2, vm := vm2, vmo := vmo2, vv := vv2, vr := vr2, vs := vs2, vb := vb2

neuralScore(t, m, mo, v, r, s) => nt*t + nm*m + nmo*mo + nv*v + nr*r + ns*s + nb
regimePenalty = 0.0
rankSource(t, m, mo, v, r, s, analog, agree, tight, k) =>
    neural = useNeural ? neuralScore(t, m, mo, v, r, s) : 0.0
    directional = math.abs(analog) / 3.0
    raw = directional * 0.35 + agree * 0.25 + tight * 0.20 + normScore(neural) * neuralInfluence + (k >= kNeighbors ? 0.10 : 0.0) - regimePenalty
    clamp(raw, 0.0, 1.0)

rO = rankSource(oT, oM, oMo, oV, oR, oS, oAnalog, oAgree, oTight, oK)
rH = rankSource(hT, hM, hMo, hV, hR, hS, hAnalog, hAgree, hTight, hK)
rL = rankSource(lT, lM, lMo, lV, lR, lS, lAnalog, lAgree, lTight, lK)
rC = rankSource(cT, cM, cMo, cV, cR, cS, cAnalog, cAgree, cTight, cK)

ready  = bankO.rows() > 20 and bankH.rows() > 20 and bankL.rows() > 20 and bankC.rows() > 20
safeRO = ready ? rO : 0.25
safeRH = ready ? rH : 0.25
safeRL = ready ? rL : 0.25
safeRC = ready ? rC : 0.25
bestId = safeRO >= safeRH and safeRO >= safeRL and safeRO >= safeRC ? 0 : safeRH >= safeRL and safeRH >= safeRC ? 1 : safeRL >= safeRC ? 2 : 3

hardSrc = bestId == 0 ? open : bestId == 1 ? high : bestId == 2 ? low : close
aiSource = ta.ema(hardSrc, srcSmoothLen)
aiMA = ma(aiSource, maLen, maType)

avgAnalog = (oAnalog + hAnalog + lAnalog + cAnalog) / 4.0
avgAgree  = (oAgree + hAgree + lAgree + cAgree) / 4.0
avgTight  = (oTight + hTight + lTight + cTight) / 4.0
aiDrive = clamp(math.abs(avgAnalog) * 0.20 + avgAgree * 0.40 + avgTight * 0.40, 0.0, 1.0)

adaptMult = stMult * (1.0 + stAdapt * (1.0 - aiDrive))
stAtr  = ta.atr(stLen)
upBand = aiSource - adaptMult * stAtr
dnBand = aiSource + adaptMult * stAtr

var float stLong = na
var float stShort = na
var int stDir = 1
stLong := na(stLong[1]) ? upBand : close[1] > stLong[1] ? math.max(upBand, stLong[1]) : upBand
stShort := na(stShort[1]) ? dnBand : close[1] < stShort[1] ? math.min(dnBand, stShort[1]) : dnBand
stDir := na(stDir[1]) ? 1 : stDir[1] == -1 and close > stShort[1] ? 1 : stDir[1] == 1 and close < stLong[1] ? -1 : nz(stDir[1], 1)
stLine   = stDir == 1 ? stLong : stShort
stFlipUp = stDir == 1 and stDir[1] == -1
stFlipDn = stDir == -1 and stDir[1] == 1

// ════════════════════════════════════════════════════════════════════════════
// 📌 EMA CLOUD
// ════════════════════════════════════════════════════════════════════════════

float emaHighSlow = ta.ema(high,  ema_slow_len)
float emaLowSlow  = ta.ema(low,   ema_slow_len)
float emaHighFast = ta.ema(high,  ema_fast_len)
float emaLowFast  = ta.ema(low,   ema_fast_len)
float ema8_close  = ta.ema(close, ema_fast_len)
float ema200_close= ta.ema(close, ema_slow_len)
float atr14  = ta.atr(14)
float offset = atr14 * signalOffsetPct
bool crossUp   = ta.crossover(ema8_close,  ema200_close)
bool crossDown = ta.crossunder(ema8_close, ema200_close)
var bool longSignalPlotted=false, var bool shortSignalPlotted=false
var float crossLowPrice=na, var float crossHighPrice=na
if crossUp
    longSignalPlotted := false
    crossLowPrice := low
if crossDown
    shortSignalPlotted := false
    crossHighPrice := high
bool longTrigger  = not longSignalPlotted  and crossUp   and close > emaHighSlow
bool shortTrigger = not shortSignalPlotted and crossDown and close < emaLowSlow
if longTrigger
    longSignalPlotted := true
if shortTrigger
    shortSignalPlotted := true
float buyPrice  = longTrigger  ? crossLowPrice  - offset : na
float sellPrice = shortTrigger ? crossHighPrice + offset : na

pHighSlow = plot(show_cloud ? emaHighSlow : na, "EMA Slow High", color = color.new(cloud_slow_col, 0), linewidth = 1)
pLowSlow  = plot(show_cloud ? emaLowSlow  : na, "EMA Slow Low",  color = color.new(cloud_slow_col, 0), linewidth = 1)
fill(pHighSlow, pLowSlow, color = show_cloud ? color.new(cloud_slow_col, 60) : na, title = "Slow Cloud Fill")
pHighFast = plot(show_cloud ? emaHighFast : na, "EMA Fast High", color = color.new(cloud_fast_col, 0), linewidth = 1)
pLowFast  = plot(show_cloud ? emaLowFast  : na, "EMA Fast Low",  color = color.new(cloud_fast_col, 0), linewidth = 1)
fill(pHighFast, pLowFast, color = show_cloud ? color.new(cloud_fast_col, 60) : na, title = "Fast Cloud Fill")
plot(show_cloud ? ema8_close : na, "EMA Fast Close", color = color.new(cloud_fast_col, 0), linewidth = 2)
plotshape(show_signals ? buyPrice  : na, "Buy Signal",  style = shape.triangleup,   location = location.absolute, color = color.new(#22c55e, 0), size = size.small)
plotshape(show_signals ? sellPrice : na, "Sell Signal", style = shape.triangledown, location = location.absolute, color = color.new(#ef4444, 0), size = size.small)

// ════════════════════════════════════════════════════════════════════════════
// 📌 S&D ZONES (rolling, unchanged)
// ════════════════════════════════════════════════════════════════════════════

bool  use_pivot  = zone_mode == '📌 Pivot — Fixed Zones'
float roll_high  = ta.highest(high, length)
float roll_low   = ta.lowest(low,  length)
float _ph        = ta.pivothigh(high, piv_l, piv_r)
float _pl        = ta.pivotlow(low,  piv_l, piv_r)
var float piv_res = ta.highest(high, 50)
var float piv_sup = ta.lowest(low,  50)
if not na(_ph)
    piv_res := _ph
if not na(_pl)
    piv_sup := _pl
float zone_hi  = use_pivot ? piv_res : roll_high
float zone_lo  = use_pivot ? piv_sup : roll_low
float atr_zone = ta.atr(200) * 0.5
float res_top  = zone_hi + atr_zone
float res_bot  = zone_hi - atr_zone
float sup_top  = zone_lo + atr_zone
float sup_bot  = zone_lo - atr_zone

// power counts (buy/sell tally over lookback) — used in zone boxes + dashboard
var int zoneBuy = 0
var int zoneSell = 0
if barstate.islast
    zoneBuy := 0
    zoneSell := 0
    for i = 0 to length - 1 by 1
        zoneBuy  := zoneBuy  + (close[i] > open[i] ? 1 : 0)
        zoneSell := zoneSell + (close[i] < open[i] ? 1 : 0)

// ════════════════════════════════════════════════════════════════════════════
// 📌 ZONE VALIDITY — TRUE = price predicted to reverse at the zone
// ════════════════════════════════════════════════════════════════════════════

float rsi14 = ta.rsi(close, 14)

float curRange  = high - low
float avgRange  = ta.sma(high - low, 10)
bool  rangeFade = curRange < avgRange * 0.85
bool  momFade   = aiDrive < aiDrive[1] and aiDrive < 0.5

// chasing detection
var int sh_rise = 0
sh_rise := zone_hi > zone_hi[1] and close > close[1] ? sh_rise + 1 : 0
bool  sh_chasing = sh_rise >= chase_bars and close > res_bot

var int lo_fall = 0
lo_fall := zone_lo < zone_lo[1] and close < close[1] ? lo_fall + 1 : 0
bool  lo_chasing = lo_fall >= chase_bars and close < sup_top

// price reaching into the zone (high taps short / low taps long)
bool sh_atzone = high >= res_bot
bool lo_atzone = low  <= sup_top

// rejection candle (confirmation flavor)
bool sh_inzone = high >= res_bot and close <= res_top
bool lo_inzone = low <= sup_top and close >= sup_bot
bool sh_rejecting = sh_inzone and close < high - (high - low) * rej_wick
bool lo_rejecting = lo_inzone and close > low  + (high - low) * rej_wick

// ── TRUE = predictive (price enters stable zone + RSI stretched)  OR  confirmed rejection ──
bool sh_predict = true_predict and sh_atzone and rsi14 >= rsi_stretch
bool lo_predict = true_predict and lo_atzone and rsi14 <= (100.0 - rsi_stretch)

bool sh_true_raw = not sh_chasing and (sh_predict or sh_rejecting)
bool lo_true_raw = not lo_chasing and (lo_predict or lo_rejecting)

// optionally lock to bar close (no intrabar flicker)
bool sh_true = true_confirm ? (sh_true_raw and barstate.isconfirmed) or sh_true_raw[1] : sh_true_raw
bool lo_true = true_confirm ? (lo_true_raw and barstate.isconfirmed) or lo_true_raw[1] : lo_true_raw

shStatus(bool chasing, float rtop, float rbot) =>
    string st = 'APPROACHING'
    if chasing
        st := 'CHASING'
    else if close > rtop
        st := 'BROKEN'
    else if high >= rbot and close <= rtop
        st := 'TESTING'
    else if close[1] <= rtop and close[1] >= rbot and close < rbot
        st := 'REVERSING'
    else
        st := 'APPROACHING'
    st
loStatus(bool chasing, float stop, float sbot) =>
    string st = 'APPROACHING'
    if chasing
        st := 'CHASING'
    else if close < sbot
        st := 'BROKEN'
    else if low <= stop and close >= sbot
        st := 'TESTING'
    else if close[1] >= sbot and close[1] <= stop and close > stop
        st := 'REVERSING'
    else
        st := 'APPROACHING'
    st

string shortStatus = shStatus(sh_chasing, res_top, res_bot)
string longStatus  = loStatus(lo_chasing, sup_top, sup_bot)

float shDistPts = zone_hi - close
float shDistPct = (zone_hi - close) / close * 100.0
float shDistATR = (zone_hi - close) / atr14
float loDistPts = close - zone_lo
float loDistPct = (close - zone_lo) / close * 100.0
float loDistATR = (close - zone_lo) / atr14

color shVerdictCol = sh_true ? tbl_good_col : sh_chasing ? tbl_bad_col : tbl_warn_col
color loVerdictCol = lo_true ? tbl_good_col : lo_chasing ? tbl_bad_col : tbl_warn_col
string shVerdict   = sh_true ? 'TRUE' : sh_chasing ? 'CHASING' : 'WEAK'
string loVerdict   = lo_true ? 'TRUE' : lo_chasing ? 'CHASING' : 'WEAK'

float htf1_high = request.security(syminfo.tickerid, htf1, ta.highest(high, htf_lb), lookahead = barmerge.lookahead_off)
float htf1_low  = request.security(syminfo.tickerid, htf1, ta.lowest(low,  htf_lb), lookahead = barmerge.lookahead_off)
float htf2_high = request.security(syminfo.tickerid, htf2, ta.highest(high, htf_lb), lookahead = barmerge.lookahead_off)
float htf2_low  = request.security(syminfo.tickerid, htf2, ta.lowest(low,  htf_lb), lookahead = barmerge.lookahead_off)
float confRange = atr14 * conf_atr
bool sh_conf = (math.abs(htf1_high - zone_hi) <= confRange) or (math.abs(htf2_high - zone_hi) <= confRange)
bool lo_conf = (math.abs(htf1_low  - zone_lo) <= confRange) or (math.abs(htf2_low  - zone_lo) <= confRange)

// ════════════════════════════════════════════════════════════════════════════
// 📌 SMART ZONE REASONING — Continuation / Reversal probabilities  (NEW)
//   Display-only intelligence layer. Does NOT touch zones, alerts, AI engine,
//   Supertrend, EMA cloud, dashboard or any existing trading logic. Every value
//   below is derived from existing indicator data and updates on every bar.
// ════════════════════════════════════════════════════════════════════════════

// --- raw component signals (all from existing indicator data) ---
float _rngSZ      = high - low
float bodyBull    = close > open and _rngSZ > 0 ? (close - open) / _rngSZ : 0.0   // strong bullish body
float bodyBear    = close < open and _rngSZ > 0 ? (open - close) / _rngSZ : 0.0   // strong bearish body
bool  atrRising   = atr14 > atr14[1]                                              // ATR expansion
bool  zoneRising  = zone_hi > zone_hi[1]                                          // supply moving up (buyers winning)
bool  zoneFalling = zone_lo < zone_lo[1]                                          // support moving down (sellers winning)
bool  aiRising    = aiDrive > aiDrive[1]                                          // AI drive increasing
bool  hh          = high > high[1]                                                // higher high
bool  ll          = low  < low[1]                                                 // lower low

// rejection candles over the last 10 bars (rejection wicks inside the zone)
int shRejN = int(math.sum(sh_rejecting ? 1.0 : 0.0, 10))
int loRejN = int(math.sum(lo_rejecting ? 1.0 : 0.0, 10))

// analog directional bias (-1..1) coming from the AI engine
float bullAnalog = avgAnalog > 0 ? clamp(avgAnalog / 1.5, 0.0, 1.0) : 0.0
float bearAnalog = avgAnalog < 0 ? clamp(-avgAnalog / 1.5, 0.0, 1.0) : 0.0

// ── SELL ZONE  Continuation = buyers pushing UP through supply (break) ──
float shContRaw = 15.0 * (zoneRising ? 1.0 : (zone_hi == zone_hi[1] ? 0.5 : 0.0)) + 10.0 * (aiRising ? 1.0 : 0.0) + 10.0 * aiDrive + 15.0 * (stDir == 1 ? 1.0 : 0.0) + 10.0 * (hh ? 1.0 : 0.0) + 10.0 * bodyBull + 8.0 * (atrRising ? 1.0 : 0.0) + 12.0 * clamp(1.0 - shRejN / 3.0, 0.0, 1.0) + 5.0 * (rsi14 < rsi_stretch ? 1.0 : 0.0) + 5.0 * bullAnalog
float shCont = math.round(clamp(shContRaw, 0.0, 100.0))   // Break Probability (buyers break supply)
float shRev  = 100.0 - shCont                             // Reversal Probability (supply holds → short)

// ── LONG ZONE  Continuation = sellers pushing DOWN through support (breakdown) ──
float loContRaw = 15.0 * (zoneFalling ? 1.0 : (zone_lo == zone_lo[1] ? 0.5 : 0.0)) + 10.0 * (aiRising ? 1.0 : 0.0) + 10.0 * aiDrive + 15.0 * (stDir == -1 ? 1.0 : 0.0) + 10.0 * (ll ? 1.0 : 0.0) + 10.0 * bodyBear + 8.0 * (atrRising ? 1.0 : 0.0) + 12.0 * clamp(1.0 - loRejN / 3.0, 0.0, 1.0) + 5.0 * (rsi14 > (100.0 - rsi_stretch) ? 1.0 : 0.0) + 5.0 * bearAnalog
float loCont = math.round(clamp(loContRaw, 0.0, 100.0))   // Breakdown Probability (sellers break support)
float loRev  = 100.0 - loCont                             // Long Probability (support holds → buy)

// directional "bullish outcome" score → drives label color (up = green, down = red)
float shBull = shCont   // supply zone: price up = continuation (buyers break)
float loBull = loRev    // demand zone: price up = bounce (support holds)

// ── ZONE STRENGTH METER components (0..100) ──
float shSupplyStr = 100.0 * clamp(0.35 * clamp(shRejN / 3.0, 0.0, 1.0) + 0.25 * (sh_conf ? 1.0 : 0.0) + 0.20 * (stDir == -1 ? 1.0 : 0.0) + 0.20 * clamp((rsi14 - 50.0) / (rsi_stretch - 50.0), 0.0, 1.0), 0.0, 1.0)
float shBuyerPress = shCont
float shRevRisk    = shRev
float shBreakRisk  = 100.0 * clamp(0.55 * (shCont / 100.0) + 0.25 * (1.0 - shSupplyStr / 100.0) + 0.20 * (atrRising ? 1.0 : 0.0), 0.0, 1.0)

float loSupportStr  = 100.0 * clamp(0.35 * clamp(loRejN / 3.0, 0.0, 1.0) + 0.25 * (lo_conf ? 1.0 : 0.0) + 0.20 * (stDir == 1 ? 1.0 : 0.0) + 0.20 * clamp((50.0 - rsi14) / (rsi_stretch - 50.0), 0.0, 1.0), 0.0, 1.0)
float loSellerPress = loCont
float loRevRisk     = loRev
float loBreakRisk   = 100.0 * clamp(0.55 * (loCont / 100.0) + 0.25 * (1.0 - loSupportStr / 100.0) + 0.20 * (atrRising ? 1.0 : 0.0), 0.0, 1.0)

// ════════════════════════════════════════════════════════════════════════════
// 📌 DRAW ZONES + HTF
// ════════════════════════════════════════════════════════════════════════════

var box shBox=na, var box loBox=na
var label shOutLbl=na, var label loOutLbl=na
var line h1h=na, var line h1l=na, var line h2h=na, var line h2l=na
var array<box> glowBoxes = array.new<box>()

if barstate.islast
    box.delete(shBox)
    box.delete(loBox)
    label.delete(shOutLbl)
    label.delete(loOutLbl)
    line.delete(h1h)
    line.delete(h1l)
    line.delete(h2h)
    line.delete(h2l)
    if glowBoxes.size() > 0
        for i = 0 to glowBoxes.size() - 1
            box.delete(glowBoxes.get(i))
        glowBoxes.clear()

    if show_zones
        int shTrans = sh_true ? 70 : sh_chasing ? 88 : 80
        int loTrans = lo_true ? 70 : lo_chasing ? 88 : 80

        if show_zoneglow
            for g = 1 to glow_layers
                float pad = atr_zone * (g * 0.6)
                int gt = math.min(90 + g, 95)
                glowBoxes.push(box.new(bar_index - length, res_top + pad, bar_index + extend, res_bot - pad, border_color = na, bgcolor = color.new(t_col, gt)))
                glowBoxes.push(box.new(bar_index - length, sup_top + pad, bar_index + extend, sup_bot - pad, border_color = na, bgcolor = color.new(b_col, gt)))

        shBox := box.new(bar_index - length, res_top, bar_index + extend, res_bot, border_color = color.new(shVerdictCol, 40), border_style = sh_chasing ? line.style_dashed : line.style_solid, bgcolor = color.new(t_col, shTrans))
        loBox := box.new(bar_index - length, sup_top, bar_index + extend, sup_bot, border_color = color.new(loVerdictCol, 40), border_style = lo_chasing ? line.style_dashed : line.style_solid, bgcolor = color.new(b_col, loTrans))

        shBox.set_text('SHORT POWER: ' + str.tostring(zoneSell))
        shBox.set_text_color(chart.fg_color)
        shBox.set_text_halign(text.align_center)
        shBox.set_text_valign(text.align_center)
        shBox.set_text_size(size.normal)
        loBox.set_text('LONG POWER: ' + str.tostring(zoneBuy))
        loBox.set_text_color(chart.fg_color)
        loBox.set_text_halign(text.align_center)
        loBox.set_text_valign(text.align_center)
        loBox.set_text_size(size.normal)

        // ── NEW INTELLIGENT SELL-ZONE LABEL (reasoning + zone-strength meter) ──
        string shHead = shBull >= 75 ? "🟢 BUYERS IN CONTROL" : shBull >= 45 ? "🟡 SUPPLY BEING TESTED" : shBull >= 20 ? "⚠ REVERSAL BUILDING" : "🔴 SELL READY"
        string shRec  = shBull >= 85 ? "BREAKOUT LIKELY — SUPPLY FAILING" : shBull >= 75 ? "DO NOT SHORT — BUYERS DOMINATING" : shBull >= 45 ? "WAIT — SUPPLY NOT CONFIRMED" : shBull >= 20 ? "WAIT FOR CONFIRMATION CANDLE" : "SHORT SETUP VALID"
        string shTxt = shHead +
             "\n━━━━━━━━━━━━━━━━━━━━" +
             "\nZone Rising: " + ynTxt(zoneRising) +
             "\nMomentum: " + momTxt(aiRising, aiDrive) +
             "\nAI Trend: " + (stDir == 1 ? "BULLISH" : "BEARISH") +
             "\nRejections: " + str.tostring(shRejN) + (shRejN >= 3 ? "  (3+)" : "") +
             (sh_conf ? "\nHTF Confluence: YES" : "") +
             "\nBreak Probability: " + pctTxt(shCont) +
             "\nReversal Probability: " + pctTxt(shRev) +
             "\n━━━━━━━━━━━━━━━━━━━━" +
             "\nSUPPLY STRENGTH\n" + makeBar(shSupplyStr) + " " + pctTxt(shSupplyStr) +
             "\nBUYER PRESSURE\n" + makeBar(shBuyerPress) + " " + pctTxt(shBuyerPress) +
             "\nREVERSAL RISK\n" + makeBar(shRevRisk) + " " + pctTxt(shRevRisk) +
             "\nBREAKOUT RISK\n" + makeBar(shBreakRisk) + " " + pctTxt(shBreakRisk) +
             "\n━━━━━━━━━━━━━━━━━━━━" +
             "\nRecommendation:\n" + shRec
        shOutLbl := label.new(bar_index + extend, res_top, shTxt, style = label.style_label_down, color = color.new(smartCol(shBull), 80), textcolor = chart.fg_color, size = size.small)

        // ── NEW INTELLIGENT LONG-ZONE LABEL (reasoning + zone-strength meter) ──
        string loHead = loBull >= 75 ? "🟢 BUY READY" : loBull >= 45 ? "🟡 SUPPORT BEING TESTED" : loBull >= 20 ? "⚠ DEMAND WEAKENING" : "🔴 SUPPORT BREAKING"
        string loRec  = loBull >= 85 ? "BUY SETUP VALID — SELLERS EXHAUSTED" : loBull >= 75 ? "BUY SETUP VALID" : loBull >= 45 ? "WAIT — SUPPORT NOT CONFIRMED" : loBull >= 20 ? "WAIT FOR CONFIRMATION CANDLE" : "DO NOT BUY — DEMAND FAILING"
        string loTxt = loHead +
             "\n━━━━━━━━━━━━━━━━━━━━" +
             "\nZone Falling: " + ynTxt(zoneFalling) +
             "\nMomentum: " + momTxt(aiRising, aiDrive) +
             "\nAI Trend: " + (stDir == 1 ? "BULLISH" : "BEARISH") +
             "\nRejections: " + str.tostring(loRejN) + (loRejN >= 3 ? "  (3+)" : "") +
             (lo_conf ? "\nHTF Confluence: YES" : "") +
             "\nLong Probability: " + pctTxt(loRev) +
             "\nBreakdown Probability: " + pctTxt(loCont) +
             "\n━━━━━━━━━━━━━━━━━━━━" +
             "\nSUPPORT STRENGTH\n" + makeBar(loSupportStr) + " " + pctTxt(loSupportStr) +
             "\nSELLER PRESSURE\n" + makeBar(loSellerPress) + " " + pctTxt(loSellerPress) +
             "\nBOUNCE CHANCE\n" + makeBar(loRevRisk) + " " + pctTxt(loRevRisk) +
             "\nBREAKDOWN RISK\n" + makeBar(loBreakRisk) + " " + pctTxt(loBreakRisk) +
             "\n━━━━━━━━━━━━━━━━━━━━" +
             "\nRecommendation:\n" + loRec
        loOutLbl := label.new(bar_index + extend, sup_bot, loTxt, style = label.style_label_up, color = color.new(smartCol(loBull), 80), textcolor = chart.fg_color, size = size.small)

    if show_htf
        h1h := line.new(bar_index - length, htf1_high, bar_index + extend, htf1_high, color = color.new(t_col, 55), style = line.style_dotted)
        h1l := line.new(bar_index - length, htf1_low,  bar_index + extend, htf1_low,  color = color.new(b_col, 55), style = line.style_dotted)
        h2h := line.new(bar_index - length, htf2_high, bar_index + extend, htf2_high, color = color.new(t_col, 30), style = line.style_dashed)
        h2l := line.new(bar_index - length, htf2_low,  bar_index + extend, htf2_low,  color = color.new(b_col, 30), style = line.style_dashed)

// ════════════════════════════════════════════════════════════════════════════
// 📌 DASHBOARD  (original layout + Verdict & Status rows)
// ════════════════════════════════════════════════════════════════════════════

var table dash = table.new(tbl_position(), 3, 12, bgcolor = tbl_bg_col, border_color = tbl_brd_col, border_width = 1, frame_color = tbl_brd_col, frame_width = 1)
tc(col, row, txt, bg, fc) => table.cell(dash, col, row, txt, bgcolor = bg, text_color = fc, text_size = tbl_sz(), text_halign = text.align_center)

if barstate.islast and show_table
    int buy = 0, sell = 0, s_touches = 0, s_bull = 0, r_touches = 0, r_bear = 0
    for i = 0 to length - 1 by 1
        buy  := buy  + (close[i] > open[i] ? 1 : 0)
        sell := sell + (close[i] < open[i] ? 1 : 0)
        if low[i]  <= sup_top and low[i]  >= sup_bot
            s_touches := s_touches + 1
            if close[i] > open[i]
                s_bull := s_bull + 1
        if high[i] >= res_bot and high[i] <= res_top
            r_touches := r_touches + 1
            if close[i] < open[i]
                r_bear := r_bear + 1

    int sp = s_touches > 0 ? math.round(s_bull * 100 / s_touches) : 50
    int rp = r_touches > 0 ? math.round(r_bear * 100 / r_touches) : 50

    bool rsi_buy_ok  = rsi14 <= 45
    bool rsi_sell_ok = rsi14 >= 55
    bool trend_bull  = stDir == 1
    bool trend_bear  = stDir == -1

    float s_pts = (sp >= 65 ? 1.0 : sp >= 45 ? 0.5 : 0.0) + (rsi_buy_ok ? 1.0 : 0.5) + (trend_bull ? 1.0 : 0.0)
    float r_pts = (rp >= 65 ? 1.0 : rp >= 45 ? 0.5 : 0.0) + (rsi_sell_ok ? 1.0 : 0.5) + (trend_bear ? 1.0 : 0.0)

    string s_stars = s_pts >= 2.5 ? '★★★  A+  TAKE IT' : s_pts >= 2.0 ? '★★☆  A    GOOD' : s_pts >= 1.5 ? '★☆☆  B    WAIT' : '☆☆☆  C    SKIP'
    string r_stars = r_pts >= 2.5 ? '★★★  A+  TAKE IT' : r_pts >= 2.0 ? '★★☆  A    GOOD' : r_pts >= 1.5 ? '★☆☆  B    WAIT' : '☆☆☆  C    SKIP'

    color s_sc_col = s_pts >= 2.0 ? tbl_good_col : s_pts >= 1.5 ? tbl_warn_col : tbl_bad_col
    color r_sc_col = r_pts >= 2.0 ? tbl_good_col : r_pts >= 1.5 ? tbl_warn_col : tbl_bad_col
    color s_rv_col = sp >= 65 ? tbl_good_col : sp >= 45 ? tbl_warn_col : tbl_bad_col
    color r_rv_col = rp >= 65 ? tbl_good_col : rp >= 45 ? tbl_warn_col : tbl_bad_col

    color buy_hdr  = color.new(b_col, 70)
    color sel_hdr  = color.new(t_col, 70)
    color buy_bg   = color.new(b_col, 88)
    color sel_bg   = color.new(t_col, 88)
    color lbl_bg   = color.new(tbl_bg_col, 0)
    string mode_lbl = use_pivot ? '📌 Pivot' : '📉 Rolling'
    color  mode_col = use_pivot ? tbl_good_col : tbl_warn_col

    tc(0, 0, '',             lbl_bg,  tbl_lbl_col)
    tc(1, 0, '▲  BUY ZONE',  buy_hdr, b_col)
    tc(2, 0, '▼  SELL ZONE', sel_hdr, t_col)
    tc(0, 1, 'Verdict', lbl_bg, tbl_lbl_col)
    tc(1, 1, loVerdict, color.new(loVerdictCol, 75), loVerdictCol)
    tc(2, 1, shVerdict, color.new(shVerdictCol, 75), shVerdictCol)
    tc(0, 2, 'Status', lbl_bg, tbl_lbl_col)
    tc(1, 2, longStatus,  buy_bg, loVerdictCol)
    tc(2, 2, shortStatus, sel_bg, shVerdictCol)
    tc(0, 3, 'Power',            lbl_bg, tbl_lbl_col)
    tc(1, 3, str.tostring(buy),  buy_bg, tbl_val_col)
    tc(2, 3, str.tostring(sell), sel_bg, tbl_val_col)
    tc(0, 4, 'Tested',                      lbl_bg, tbl_lbl_col)
    tc(1, 4, str.tostring(s_touches) + 'x', buy_bg, tbl_val_col)
    tc(2, 4, str.tostring(r_touches) + 'x', sel_bg, tbl_val_col)
    tc(0, 5, 'Reversal %', lbl_bg, tbl_lbl_col)
    tc(1, 5, str.tostring(sp) + '%  ' + (sp >= 65 ? '▲ Strong' : sp >= 45 ? '~ Mod' : '▽ Weak'), buy_bg, s_rv_col)
    tc(2, 5, str.tostring(rp) + '%  ' + (rp >= 65 ? '▼ Strong' : rp >= 45 ? '~ Mod' : '△ Weak'), sel_bg, r_rv_col)
    tc(0, 6, 'RSI  ' + str.tostring(math.round(rsi14)), lbl_bg, tbl_lbl_col)
    tc(1, 6, rsi_buy_ok  ? '✓ Oversold'   : '— Neutral', buy_bg, rsi_buy_ok  ? tbl_good_col : tbl_lbl_col)
    tc(2, 6, rsi_sell_ok ? '✓ Overbought' : '— Neutral', sel_bg, rsi_sell_ok ? tbl_good_col : tbl_lbl_col)
    tc(0, 7, 'AI Trend', lbl_bg, tbl_lbl_col)
    tc(1, 7, trend_bull ? '↑ Bullish' : '↓ Against', buy_bg, trend_bull ? tbl_good_col : tbl_warn_col)
    tc(2, 7, trend_bear ? '↓ Bearish' : '↑ Against', sel_bg, trend_bear ? tbl_good_col : tbl_warn_col)
    tc(0, 8, 'HTF Conf', lbl_bg, tbl_lbl_col)
    tc(1, 8, lo_conf ? '✓ YES' : '— no', buy_bg, lo_conf ? tbl_good_col : tbl_lbl_col)
    tc(2, 8, sh_conf ? '✓ YES' : '— no', sel_bg, sh_conf ? tbl_good_col : tbl_lbl_col)
    tc(0, 9, 'Mode',    lbl_bg, tbl_lbl_col)
    tc(1, 9, mode_lbl,  buy_bg, mode_col)
    tc(2, 9, mode_lbl,  sel_bg, mode_col)
    tc(0, 10, '─────────', lbl_bg, color.new(tbl_brd_col, 30))
    tc(1, 10, '─────────', buy_bg, color.new(tbl_brd_col, 30))
    tc(2, 10, '─────────', sel_bg, color.new(tbl_brd_col, 30))
    tc(0, 11, 'Score',   lbl_bg, tbl_lbl_col)
    tc(1, 11, s_stars,   buy_bg, s_sc_col)
    tc(2, 11, r_stars,   sel_bg, r_sc_col)

// ════════════════════════════════════════════════════════════════════════════
// 📌 AI SUPERTREND VISUALIZATION  (layered inner/outer glow look)
// ════════════════════════════════════════════════════════════════════════════

maCol   = stDir == 1 ? bullCol : bearCol
trailUp = showST and stDir == 1 ? stLine : na
trailDn = showST and stDir == -1 ? stLine : na


plot(trailUp, "AI Trail Up Outer", color=color.new(bullCol, 70), linewidth=6, style=plot.style_linebr, force_overlay=true)
plot(trailDn, "AI Trail Dn Outer", color=color.new(bearCol, 70), linewidth=6, style=plot.style_linebr, force_overlay=true)
pTrailUp = plot(trailUp, "AI Supertrend Up", color=color.new(bullCol, 0), linewidth=2, style=plot.style_linebr, force_overlay=true)
pTrailDn = plot(trailDn, "AI Supertrend Down", color=color.new(bearCol, 0), linewidth=2, style=plot.style_linebr, force_overlay=true)

pClose = plot(close, "Glow Anchor", display=display.none, editable=false, force_overlay=true)

fill(pTrailUp, pClose, trailUp, close, showTrailGlow ? color.new(bullCol, 85) : na, color(na))
fill(pTrailDn, pClose, trailDn, close, showTrailGlow ? color.new(bearCol, 85) : na, color(na))

c_ = stDir == 1 ? color.new(bullCol, 0) : color.new(bearCol, 0)
plotcandle(showCandles ? open : na, showCandles ? high : na, showCandles ? low : na, showCandles ? close : na, color=c_, wickcolor=c_, bordercolor=c_)

sourceChanged = bestId != bestId[1]
plotshape(showSourceMarks and sourceChanged and bestId == 0, title="Source Open", text="O", style=shape.labelup, location=location.belowbar, color=color.new(neutralCol, 0), textcolor=color.white, size=size.tiny)
plotshape(showSourceMarks and sourceChanged and bestId == 1, title="Source High", text="H", style=shape.labelup, location=location.belowbar, color=color.new(bullCol, 0), textcolor=color.black, size=size.tiny)
plotshape(showSourceMarks and sourceChanged and bestId == 2, title="Source Low", text="L", style=shape.labeldown, location=location.abovebar, color=color.new(bearCol, 0), textcolor=color.white, size=size.tiny)
plotshape(showSourceMarks and sourceChanged and bestId == 3, title="Source Close", text="C", style=shape.labelup, location=location.belowbar, color=color.new(color.white, 0), textcolor=color.black, size=size.tiny)

plotshape(showFlipMarks and stFlipUp?trailUp:na, title="Trend Flip Up", style=shape.triangleup, location=location.absolute, color=bullCol, size=size.tiny, force_overlay=true)
plotshape(showFlipMarks and stFlipDn?trailDn:na, title="Trend Flip Down", style=shape.triangledown, location=location.absolute, color=bearCol, size=size.tiny, force_overlay=true)
plotshape(showFlipMarks and stFlipUp?trailUp:na, title="Trend Flip Up Glow", style=shape.triangleup, location=location.absolute, color=color.new(bullCol,50), size=size.small, force_overlay=true)
plotshape(showFlipMarks and stFlipDn?trailDn:na, title="Trend Flip Down Glow", style=shape.triangledown, location=location.absolute, color=color.new(bearCol,50), size=size.small, force_overlay=true)

alertcondition(stFlipUp, "AI Trend Flip Up", "AI Supertrend flipped bullish")
alertcondition(stFlipDn, "AI Trend Flip Down", "AI Supertrend flipped bearish")

float trailVal = stLine          // the active AI Supertrend line
float trailDist = atr14 * 0.25   // how close a tap counts (quarter ATR)

// BULLISH bounce: uptrend, price dipped to/near the trail but closed back above it (held support)
bool trailBounceUp = stDir == 1 and stDir[1] == 1 and low <= trailVal + trailDist and close > trailVal and close >= open

// BEARISH bounce: downtrend, price rallied to/near the trail but closed back below it (held resistance)
bool trailBounceDn = stDir == -1 and stDir[1] == -1 and high >= trailVal - trailDist and close < trailVal and close <= open

// visual marker on the bounce
plotshape(trailBounceUp ? low : na,  title="Trail Bounce Up",  style=shape.triangleup,   location=location.belowbar, color=color.new(bullCol, 0), size=size.tiny, force_overlay=true)
plotshape(trailBounceDn ? high : na, title="Trail Bounce Down", style=shape.triangledown, location=location.abovebar, color=color.new(bearCol, 0), size=size.tiny, force_overlay=true)

alertcondition(trailBounceUp, "AI Trail Bounce UP",   "Price bounced UP off the AI trend line — bullish")
alertcondition(trailBounceDn, "AI Trail Bounce DOWN", "Price bounced DOWN off the AI trend line — bearish")
// ════════════════════════════════════════════════════════════════════════════
// 📌 ZONE ALERTS
// ════════════════════════════════════════════════════════════════════════════

bool shEnter = (high >= res_bot and low <= res_top) and not (high[1] >= res_bot[1] and low[1] <= res_top[1])
bool loEnter = (low <= sup_top and high >= sup_bot) and not (low[1] <= sup_top[1] and high[1] >= sup_bot[1])
alertcondition(shEnter, "Price Entered SHORT Power Zone", "Price tapped the SHORT power zone")
alertcondition(loEnter, "Price Entered LONG Power Zone",  "Price tapped the LONG power zone")

alertcondition(sh_true and not sh_true[1], "SHORT Zone TRUE", "SHORT power zone — predicted reversal")
alertcondition(lo_true and not lo_true[1], "LONG Zone TRUE",  "LONG power zone — predicted reversal")
