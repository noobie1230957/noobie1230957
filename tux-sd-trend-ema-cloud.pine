var string t6 = "Bars ahead used to label outcomes in learning."
var string t7 = "Spacing between historical analog samples."
var string t8 = "ATR threshold to classify forward-move strength."
var string t9 = "Enables online neural training layer."
var string t10 = "How much neural score contributes to ranking."
var string t11 = "Neural optimizer step size."
var string t12 = "Huber loss threshold during neural training."
var string t13 = "Enables Fisher-based auto feature weighting."
var string t14 = "How fast Fisher weights adapt."
var string t15 = "Minimum allowed feature weight."
var string t16 = "Minimum rows before Fisher weighting is active."
