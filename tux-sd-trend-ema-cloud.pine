int    piv_r     = input.int(10, 'Pivot Right Bars', group = '── S&D Zones ──', minval = 3, maxval = 30)
color  t_col     = input.color(color.fuchsia, 'Resistance', group = '── S&D Zones ──', inline = 'zcol')
color  b_col     = input.color(color.lime,    'Support',    group = '── S&D Zones ──', inline = 'zcol')

float  rsi_stretch  = input.float(68.0, 'RSI Stretch Threshold', group = '── Zone Validity ──', minval = 50, maxval = 90, step = 1)
int    chase_bars   = input.int(3, 'Bars Re-rising = Chasing', group = '── Zone Validity ──', minval = 1, maxval = 10)
